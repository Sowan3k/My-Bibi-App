# =============================================================================
# My Bibi — Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# =============================================================================

# Vault — where markdown files and the SQLite database live
VAULT_PATH=./vault
# Host path for the Docker volume bind mount
VAULT_HOST_PATH=./vault

# Auth — CHANGE BOTH SECRETS before deploying
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRE_MINUTES=60
INVITE_SECRET=change-me-too-different-from-jwt-secret

# URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Ollama (Phase 3 — optional, backend works without it)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# Environment
ENVIRONMENT=production

# Encryption (Phase 4)
# ENCRYPTION_SALT=random-32-char-string
